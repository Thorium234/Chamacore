# ChamaCore environment template.
#
# Copy this file to `.env` (which is git-ignored) and fill in the values:
#
#   cp .env.example .env
#
# This file carries NO real secrets. Never commit a `.env` file.

# --- App settings (CHAMACORE_* matches app/core/config.py) ---

# Development default; production MUST set false plus real secrets below.
CHAMACORE_DEBUG=true

# SQLite for local development; PostgreSQL in production.
CHAMACORE_DATABASE_URL=sqlite:///./chamacore.db

# Random secret used to sign JWTs. REQUIRED to set in production.
CHAMACORE_JWT_SECRET_KEY=local-development-only-secret-change-me-in-prod

# Base64-encoded 32-byte AES key sealing provider credentials.
# Only required when CHAMACORE_DEBUG=false.
# Generate one with:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
CHAMACORE_CREDENTIAL_ENCRYPTION_KEY=

# Public base URL used for provider callback URLs.
CHAMACORE_PUBLIC_BASE_URL=http://localhost:8000

# Comma-separated browser origins allowed to call the API (CORS).
# Explicit origins ONLY — never "*" (allow_credentials is enabled).
# Server-to-server provider callbacks (Daraja STK/C2B) are not subject to CORS.
CHAMACORE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Daraja sandbox credentials ---
#
# Used when creating (and optionally validating) a payment connection through
# `scripts/create_daraja_connection.py` or the API directly.
#
#   DARAJA_CONSUMER_KEY=
#   DARAJA_CONSUMER_SECRET=
#   DARAJA_SHORT_CODE=
#   DARAJA_PASSKEY=
# ChamaCore environment template.
# Copy this file to `.env`. `.env` is ignored; never commit runtime secrets.

# --- App settings (CHAMACORE_* matches app/core/config.py) ---

# Development default. Production MUST set false and supply real secrets below.
CHAMACORE_DEBUG=true

# Use SQLite only for local development. Production uses PostgreSQL.
CHAMACORE_DATABASE_URL=sqlite:///./chamacore.db
# CHAMACORE_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/chamacore

# Development-only placeholder. Production MUST replace this through its secret store.
CHAMACORE_JWT_SECRET_KEY=local-development-only-secret-change-me-in-prod

# # Access-token lifetime in minutes (default 120). Short-lived by design
# # (production-readiness brief 3.1): clients keep sessions alive by exchanging
# # their refresh token at POST /api/v1/auth/refresh.
# #CHAMACORE_JWT_EXPIRES_MINUTES=120

# # Refresh-token lifetime in days (default 30). Refresh tokens are single-use
# # and rotate: presenting the same token twice revokes it (reuse detection).
# #CHAMACORE_REFRESH_TOKEN_EXPIRES_DAYS=30

# # Shared secret protecting GET /metrics in production. When
# # CHAMACORE_DEBUG=false, the endpoint only answers requests carrying the
# # token in the X-Metrics-Token header; if this is left empty, /metrics
# # returns 404 so the scrape path is never public. Debug builds skip the check.
# # Generate one with:
# #   python -c "import secrets; print(secrets.token_urlsafe(32))"
# #CHAMACORE_METRICS_TOKEN=

# # Base64-encoded 32-byte AES key sealing provider credentials.
# # Only required when CHAMACORE_DEBUG=false.
# # Generate one with:
# #   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# CHAMACORE_CREDENTIAL_ENCRYPTION_KEY=

# Exactly one public base URL used for provider callback URLs. Do not use a
# comma-separated list here; callback URLs must resolve to one host.
CHAMACORE_PUBLIC_BASE_URL=http://localhost:8000

# Comma-separated browser origins allowed to call the API. Use explicit origins
# only; never use "*" because credentials are enabled.
CHAMACORE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# # --- Daraja sandbox credentials ---
# #
# # Used when creating (and optionally validating) a payment connection through
# # `scripts/create_daraja_connection.py` or the API directly.
# #
# #   DARAJA_CONSUMER_KEY=
# #   DARAJA_CONSUMER_SECRET=
# #   DARAJA_SHORT_CODE=
# #   DARAJA_PASSKEY=

# First platform administrator bootstrap (optional). Put actual credentials
# only in the ignored .env file or deployment secret store, never in Git.
# Set all four values before the bootstrap Alembic revision, or run
# `python -m app.db.bootstrap_platform_admin` after migrations.
# CHAMACORE_BOOTSTRAP_PLATFORM_ADMIN_EMAIL=
# CHAMACORE_BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=
# CHAMACORE_BOOTSTRAP_PLATFORM_ADMIN_PHONE=
# CHAMACORE_BOOTSTRAP_PLATFORM_ADMIN_GOVERNMENT_ID=
# CHAMACORE_BOOTSTRAP_PLATFORM_ADMIN_FIRST_NAME=Platform
# CHAMACORE_BOOTSTRAP_PLATFORM_ADMIN_LAST_NAME=Developer
